#!/usr/bin/env sh
# Check that this vault has everything it needs to work, and repair the small
# structural things itself.
#
#   brain/bin/doctor            check, and fix missing folders, missing .gitkeeps
#                               and lost +x bits
#   brain/bin/doctor --check    report only, change nothing
#
# One line per check: [ok] fine · [fx] fixed for you · [!!] worth fixing ·
# [XX] blocking. Every problem comes with the exact thing to do about it, in
# words rather than jargon — this is the file you run when something isn't
# working and you don't yet know enough to guess why.
#
# Use --check when nobody is watching — a scheduler, a CI job, a pre-commit
# hook — so a run can never surprise you with a change you didn't ask for.
#
# Exits 1 if anything is blocking, 0 otherwise, so a script can call it too.
# Portable on purpose: POSIX shell, no jq, no runtime.

set -u

fixing=1
for arg in "$@"; do
  case "$arg" in
    --check) fixing=0 ;;
    *) echo "doctor: unknown option '$arg' — usage: brain/bin/doctor [--check]" >&2
       exit 64 ;;
  esac
done

# Anchor to the script's own location, not the working directory: asking git
# for the toplevel walks upward, so a vault nested in another repo makes this
# inspect that repo instead — reporting the harness itself as missing.
root=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P) || root=''

# The same guard doctor uses for in_vault: structure is what proves we are in
# the vault, rather than in some directory that merely contains one.
if [ -z "$root" ] || [ ! -f "$root/AGENTS.md" ] || [ ! -d "$root/brain/bin" ]; then
  echo "doctor: ${root:-$0} is not a vault — AGENTS.md and brain/bin/ should both be there. Nothing was checked." >&2
  exit 1
fi
cd "$root" || exit 1

blockers=0
warnings=0
fixes=0

ok()    { printf '  [ok] %s\n' "$1"; }
fixed() { printf '  [fx] %s\n' "$1"; fixes=$((fixes + 1)); }
warn()  { printf '  [!!] %s\n' "$1"; [ -n "${2:-}" ] && printf '       -> %s\n' "$2"
          warnings=$((warnings + 1)); }
fail()  { printf '  [XX] %s\n' "$1"; [ -n "${2:-}" ] && printf '       -> %s\n' "$2"
          blockers=$((blockers + 1)); }

# Findings come back from awk through a file rather than a pipe: a `while read`
# on the far side of a `|` runs in a subshell, and the warning counts it bumps
# there die with it.
tmp=${TMPDIR:-/tmp}/brain-doctor.$$
trap 'rm -f "$tmp"' EXIT INT TERM
tab=$(printf '\t')

echo
echo "Second brain — checkup"
echo

# ---------------------------------------------------------------- the basics

echo "Foundations"

if command -v git >/dev/null 2>&1; then
  ok "git is installed"
else
  fail "git is not installed" \
       "Mac: install Xcode command line tools with  xcode-select --install"
fi

if git rev-parse --git-dir >/dev/null 2>&1; then
  ok "this folder is a git repository (so every change is undoable)"
else
  fail "this folder is not a git repository — nothing here can be undone" \
       "Run:  git init && git add -A && git commit -m 'my second brain'"
fi

# git refuses to commit for someone it can't name. The vault commits after every
# turn, so an unset identity isn't a style problem — it is the whole save loop
# failing quietly inside a hook nobody reads the output of.
gname=$(git config user.name 2>/dev/null || true)
gmail=$(git config user.email 2>/dev/null || true)
if [ -n "$gname" ] && [ -n "$gmail" ]; then
  ok "git knows who you are ($gname <$gmail>)"
else
  fail "git has no name or email set, so nothing here can be committed" \
       "Run:  git config --global user.name 'Your Name' && git config --global user.email 'you@example.com'"
fi

# A remote is optional, but it is the difference between "backed up" and not.
if [ -n "$(git remote 2>/dev/null)" ]; then
  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    ok "backed up to $(git remote get-url origin 2>/dev/null || echo 'a remote')"
  else
    warn "a remote exists but this branch doesn't push to it yet" \
         "Run:  git push -u origin $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  fi
else
  warn "no backup — this vault exists only on this machine" \
       "Create an empty private repo on github.com, then:  git remote add origin <url> && git push -u origin main"
fi

echo

# ------------------------------------------------------------------ the agent

echo "Your agent"

agent=${BRAIN_AGENT:-}
if [ -n "$agent" ]; then
  if command -v "$agent" >/dev/null 2>&1; then
    ok "using $agent (set by BRAIN_AGENT)"
  else
    fail "BRAIN_AGENT is set to '$agent', but that command isn't installed" \
         "Unset it, or install $agent"
  fi
else
  found=""
  for candidate in claude codex cursor-agent gemini; do
    if command -v "$candidate" >/dev/null 2>&1; then
      found="$found $candidate"
    fi
  done
  if [ -n "$found" ]; then
    # shellcheck disable=SC2086  # word-splitting is what turns the list into a first item
    set -- $found
    ok "found:$found — the vault will use $1 by default"
  else
    fail "no agent CLI found — the vault has nothing to run it" \
         "Install one, e.g. Claude Code:  npm install -g @anthropic-ai/claude-code"
  fi
fi

# jq is only needed by ingest-sessions, and only on some paths.
if command -v jq >/dev/null 2>&1; then
  ok "jq is installed (ingest-sessions reads transcripts faster with it)"
else
  warn "jq is not installed — ingest-sessions works without it, but slower" \
       "Optional. Mac:  brew install jq"
fi

echo

# ------------------------------------------------------------------ the vault

echo "The vault"

# --------------------------------------------------------------------------
# The line this script will not cross: STRUCTURE YES, CONTENT AND PATHS NEVER.
#
# Everything below may create an empty folder, drop a .gitkeep into one, or put
# back an executable bit. None of those can destroy anything: an empty folder
# holds no meaning, and a missing +x is a fact about the filesystem, not about
# you.
#
# It may never create, move, rename, delete or rewrite a note — not even an
# obviously misfiled one, not even to fix frontmatter. Those are the operations
# that break inbound [[wikilinks]] and quietly change what a note means, and a
# health check running unattended is the worst possible place for them. They
# belong to  maintain , which is conservative, explains itself, and is read by
# a human before it lands.
# --------------------------------------------------------------------------

# Distinguish "the vault is missing a folder" from "you are not in the vault".
# Creating 00_Inbox/ in someone's home directory would be its own small disaster,
# so the harness has to be here before anything gets made.
in_vault=0
[ -f AGENTS.md ] && [ -d brain/bin ] && in_vault=1

# A folder counts as empty for git's purposes if the only things in it are the
# gitkeep itself and macOS's litter, so both are excluded from the look. Globs
# rather than find, because -mindepth isn't POSIX; an unmatched glob stays
# literal, which is what the -e test is there to catch.
otherwise_empty() {
  for e in "$1"/* "$1"/.[!.]*; do
    [ -e "$e" ] || continue
    case "${e##*/}" in .gitkeep|.DS_Store) continue ;; esac
    return 1
  done
  return 0
}

missing=""
unfixed=0
for d in cortex cortex/00_Inbox cortex/01_Projects cortex/02_Areas cortex/03_Resources \
         cortex/04_Archive cortex/05_Attachments cortex/Tasks cortex/Daily cortex/raw; do
  if [ ! -d "$d" ]; then
    if [ "$in_vault" -eq 0 ]; then
      missing="$missing $d"
    elif [ "$fixing" -eq 1 ] && mkdir -p "$d" 2>/dev/null && : > "$d/.gitkeep" 2>/dev/null; then
      fixed "created the missing $d/ folder (with a .gitkeep so git keeps it)"
    else
      warn "the $d/ folder is missing" \
           "Run:  brain/bin/doctor   — without --check it makes the folder for you"
      unfixed=$((unfixed + 1))
    fi
  elif [ ! -f "$d/.gitkeep" ] && otherwise_empty "$d"; then
    # An empty folder without a .gitkeep doesn't exist as far as a clone is
    # concerned, so the next machine to pull silently loses it.
    if [ "$fixing" -eq 1 ] && : > "$d/.gitkeep" 2>/dev/null; then
      fixed "put a .gitkeep back in the empty $d/ (git doesn't track empty folders)"
    else
      warn "$d/ is empty and has no .gitkeep, so a fresh clone won't have it" \
           "Run:  brain/bin/doctor   — without --check it puts the .gitkeep back"
      unfixed=$((unfixed + 1))
    fi
  fi
done

# The harness folders are a different kind of missing: an empty brain/prompts/
# is no more useful than no brain/prompts/, so there is nothing to fix here.
for d in brain/prompts brain/bin; do
  [ -d "$d" ] || missing="$missing $d"
done

if [ -n "$missing" ]; then
  fail "missing folders:$missing" \
       "You're probably not in the vault directory. cd into it and try again."
elif [ "$unfixed" -eq 0 ]; then
  ok "all folders present"
fi

for s in run sync sessions doctor check feeds weather recent; do
  [ -f "brain/bin/$s" ] || fail "brain/bin/$s is missing" \
                                "Re-download the repo — part of the harness is gone"
done

# A lost +x usually arrives by way of a zip file, a Windows checkout or a copy
# onto a FAT drive. It says nothing about the contents, so it is safe to restore.
for f in brain/bin/*; do
  [ -f "$f" ] || continue
  [ -x "$f" ] && continue
  if [ "$fixing" -eq 1 ] && chmod +x "$f" 2>/dev/null; then
    fixed "made $f executable again"
  else
    warn "$f isn't executable, so nothing can run it" \
         "Run:  chmod +x brain/bin/*"
  fi
done
[ -x brain/bin/run ] && [ -x brain/bin/sync ] && ok "the scripts can run"

# The single highest-leverage thing a new user can do, and the one they skip.
profile='cortex/03_Resources/About me.md'
register='cortex/03_Resources/Assumptions.md'
if [ ! -f AGENTS.md ]; then
  fail "AGENTS.md is missing — this is the manual every agent reads" \
       "Re-download the repo"
elif [ ! -f "$profile" ] || grep -qE '^- \*\*Name:\*\*[[:space:]]*$' "$profile" 2>/dev/null; then
  # Distinguish "never filled in" from "filled in once and since lost". The second
  # is the alarming one: the vault silently went back to not knowing its owner, and
  # without this the human only finds out from an agent that has forgotten them.
  had=$(git log --diff-filter=A --format='%h' -1 -- "$profile" 2>/dev/null)
  if [ -n "$had" ]; then
    warn "you had a profile in '$profile' and it's gone now" \
         "It was added in $had. Get it back with:  git checkout $had -- '$profile'   (then run  setup  again if it's out of date)"
  else
    warn "this vault doesn't know who you are yet" \
         "Say  setup  to your agent — it'll ask you six questions and write '$profile'. This one change matters more than everything else here."
  fi
else
  ok "the vault knows who you are"
fi

# The profile is read at the start of every session, which is exactly what makes
# it valuable and exactly why it has to stay short. Report only — trimming
# someone's own words is not a health check's business.
profile_cap=40
if [ -f "$profile" ]; then
  plines=$(wc -l < "$profile" 2>/dev/null | tr -d ' ')
  if [ "${plines:-0}" -gt "$profile_cap" ]; then
    warn "'$profile' is $plines lines long — the cap is $profile_cap" \
         "Every line here is re-read at the start of every session and on every turn after it, so you pay for it over and over. Keep the hub to the five headings and move the detail out into linked spoke notes."
  fi
fi

# Count only the human's notes — the shipped examples are tagged, so a fresh
# vault reads as empty rather than as "2 notes" the human never wrote. The profile
# isn't a capture either: a vault that's had setup run and nothing else is empty.
# Nor is the register: it is what the brain concluded, not something the human
# said, and counting it would let the vault cite its own output as evidence about
# its owner. brain/bin/check excludes both for that reason and the two have to
# agree, or the same vault gets two different answers to "how much is here".
notes=$(find cortex/03_Resources cortex/01_Projects cortex/02_Areas -name '*.md' \
          ! -path "$profile" ! -path "$register" 2>/dev/null \
        -exec grep -L 'pkm, example' {} + 2>/dev/null | wc -l | tr -d ' ')
if [ "$notes" -eq 0 ]; then
  echo "  [--] no notes yet — that's expected on day one"
  echo "       -> Try:  capture <anything on your mind>"
elif [ "$notes" -eq 1 ]; then
  ok "1 note"
else
  ok "$notes notes"
fi

# The register only exists once the brain has concluded something about you. Its
# absence is normal; a malformed one is not, because an assumption that loses its
# label is the one kind of note that quietly turns into a fact.
if [ -f "$register" ]; then
  if [ -x brain/bin/check ] && brain/bin/check >/dev/null 2>&1; then
    ok "the assumption register is well-formed"
  else
    warn "the assumption register has problems" \
         "Run:  brain/bin/check   — it prints each one and what to do about it"
  fi
fi

echo

# ------------------------------------------------------------------- tasks
#
# Tasks/ holds one note per open task; a task that stops being open keeps its
# note and gains a closing date. The date is the entire point. Without it,
# "how long was this open?" is unanswerable, and a task quietly abandoned in
# March looks exactly like one finished this morning.

task_dirs=""
[ -d cortex/Tasks ]      && task_dirs="$task_dirs cortex/Tasks"
[ -d cortex/04_Archive ] && task_dirs="$task_dirs cortex/04_Archive"

if [ -n "$task_dirs" ]; then
  echo "Tasks"

  : > "$tmp"
  # shellcheck disable=SC2086  # the list is ours; splitting it is how find takes it
  find $task_dirs -name '*.md' -type f 2>/dev/null -exec awk '
    function verdict() {
      if (fn == "") return
      if (task == "done" || task == "dropped") {
        closed++
        if (!dated) print "nodate\t" fn "\t" task
      } else if (task == "open") {
        opened++
        if (dated) print "opendated\t" fn "\t" task
        if (fn ~ /^cortex\/04_Archive\//) print "stranded\t" fn "\t" task
      }
    }
    FNR == 1 {
      verdict()
      fn = FILENAME; sub(/^\.\//, "", fn)
      infm = ($0 ~ /^---[ \t]*$/) ? 1 : 0
      task = ""; dated = 0
      next
    }
    !infm { next }
    /^---[ \t]*$/      { infm = 0; next }
    /^task:[ \t]/      { v = $2; gsub(/"/, "", v); task = v; next }
    /^completed:[ \t]/ { v = $2; gsub(/"/, "", v); if (v ~ /[0-9]/) dated = 1; next }
    END { verdict(); print "tally\t" opened + 0 "\t" closed + 0 }
  ' {} + >> "$tmp" 2>/dev/null

  tasks_open=0
  tasks_closed=0
  task_problems=0
  while IFS="$tab" read -r kind f extra; do
    case "${kind:-}" in
      tally)
        tasks_open=$((tasks_open + f))
        tasks_closed=$((tasks_closed + extra))
        ;;
      nodate)
        warn "$f is  task: $extra  but has no  completed:  date" \
             "Add  completed: YYYY-MM-DD  to its frontmatter — the day you actually stopped. Until it's there, nothing can tell you how long this one ran."
        task_problems=$((task_problems + 1))
        ;;
      opendated)
        warn "$f is still  task: open  yet already carries a  completed:  date" \
             "One of the two is wrong. Set  task: done  (or  task: dropped ) if it's over, or delete the  completed:  line if it isn't."
        task_problems=$((task_problems + 1))
        ;;
      stranded)
        warn "$f is archived but still  task: open  — it was filed away without being closed out" \
             "Decide which it was: add  task: done  or  task: dropped  plus  completed: YYYY-MM-DD . If it's genuinely still live, move the note back to cortex/Tasks/ yourself."
        task_problems=$((task_problems + 1))
        ;;
    esac
  done < "$tmp"

  if [ "$task_problems" -eq 0 ]; then
    if [ "$((tasks_open + tasks_closed))" -eq 0 ]; then
      echo "  [--] no tasks yet — cortex/Tasks/ takes one note per open task"
      echo "       -> Try:  capture <something you owe someone>"
    else
      ok "$tasks_open open, $tasks_closed closed — and every closed one is dated"
    fi
  fi

  echo
fi

# ------------------------------------------------- the commands and the tools
#
# Two ways a command is broken before anyone runs it: a tool that never says
# what it needs, and a wrapper pointing at a prompt that isn't there any more.
# Both fail in the middle of a session, which is the expensive place to find out.

if [ -d .claude/commands ] || [ -d brain/tools ]; then
  echo "Commands and tools"

  cmd_problems=0

  # brain/tools/ is newer than the rest of the harness and may simply not exist
  # yet — that's not a fault, so say nothing about it.
  ntools=0
  if [ -d brain/tools ]; then
    for f in brain/tools/*.md; do
      [ -f "$f" ] && ntools=$((ntools + 1))
    done
  fi

  if [ "$ntools" -gt 0 ]; then
    # All five fields of the contract, not the two that are easiest to check.
    # writes: is the one that earns its place: a tool saying  writes: none  and
    # then leaving a file behind is a broken promise, and nothing catches it if
    # the field is never read in the first place.
    awk '
      function verdict(   miss) {
        if (fn == "") return
        if (!hasfm) { print fn "\thas no YAML frontmatter, so it declares nothing"; return }
        miss = ""
        if (!nm)   miss = miss "  name:"
        if (!req)  miss = miss "  requires:"
        if (!fb)   miss = miss "  fallback:"
        if (!wr)   miss = miss "  writes:"
        if (!cons) miss = miss "  consent:"
        if (miss != "") print fn "\tdeclares no" miss
      }
      FNR == 1 {
        verdict()
        fn = FILENAME; sub(/^\.\//, "", fn)
        hasfm = ($0 ~ /^---[ \t]*$/) ? 1 : 0
        infm = hasfm; nm = 0; req = 0; fb = 0; wr = 0; cons = 0
        next
      }
      !infm { next }
      /^---[ \t]*$/ { infm = 0; next }
      /^name:/      { nm = 1; next }
      /^requires:/  { req = 1; next }
      /^fallback:/  { fb = 1; next }
      /^writes:/    { wr = 1; next }
      /^consent:/   { cons = 1; next }
      END { verdict() }
    ' brain/tools/*.md > "$tmp" 2>/dev/null

    while IFS="$tab" read -r f miss; do
      [ -n "${f:-}" ] || continue
      warn "$f $miss" \
           "Add them to its frontmatter.  name:  is what it's called;  requires:  names what has to be installed or reachable;  fallback:  says what to do when it isn't;  writes:  is  none  or exactly what it may leave behind;  consent:  is  implicit  or  opt-in . A tool that declares none of this strands whoever called it halfway through, and nothing can hold it to a promise it never made."
      cmd_problems=$((cmd_problems + 1))
    done < "$tmp"
  fi

  # A wrapper is meant to be thin — a pointer at the shared prompt every agent
  # reads. Pointing at nothing is worse than not existing: the command still
  # shows up in the menu.
  nwrap=0
  for w in .claude/commands/*.md .gemini/commands/*.toml; do
    [ -f "$w" ] || continue
    nwrap=$((nwrap + 1))
    # The inlining marker first — `@file` on Claude Code, `@{file}` on Gemini —
    # because a wrapper that injects a script also names brain/bin/<something>
    # in its allowed-tools, and that would otherwise be read as the target.
    # A handful of commands are shell scripts rather than prompts, so their
    # wrapper points at brain/bin/<name> — no .md, and just as real a target.
    target=$(grep -oE '@\{?brain/(prompts|tools)/[A-Za-z0-9._-]+\.md' "$w" 2>/dev/null | head -1 | sed 's/^@{\{0,1\}//')
    [ -n "$target" ] || target=$(grep -oE 'brain/(prompts|tools)/[A-Za-z0-9._-]+\.md|brain/bin/[A-Za-z0-9._-]+' "$w" 2>/dev/null | head -1)
    if [ -z "$target" ]; then
      warn "$w names no brain/prompts/, brain/tools/ or brain/bin/ file — it's a command with nothing behind it" \
           "Point it at the shared prompt, e.g. a line reading:  Read \`brain/prompts/<name>.md\` and follow it exactly."
      cmd_problems=$((cmd_problems + 1))
    elif [ ! -f "$target" ]; then
      warn "$w points at $target, which doesn't exist" \
           "Restore $target, or delete the wrapper. As it stands the command fails the moment anyone runs it."
      cmd_problems=$((cmd_problems + 1))
    fi
  done

  if [ "$cmd_problems" -eq 0 ] && [ "$((nwrap + ntools))" -gt 0 ]; then
    summary="all $nwrap command wrappers (Claude and Gemini) point at prompts that exist"
    [ "$ntools" -gt 0 ] && summary="$summary, and all $ntools tools declare what they need"
    ok "$summary"
  fi

  echo
fi

# ------------------------------------------------- Claude Code, if it's here

if [ -d "$HOME/.claude" ]; then
  echo "Claude Code"

  if [ -f .claude/settings.json ] && grep -q '"Stop"' .claude/settings.json 2>/dev/null; then
    ok "auto-save hook is wired up (your vault commits itself after each turn)"
  else
    warn "the auto-save hook isn't configured" \
         "You'll need to run  brain/bin/sync  yourself to save your work"
  fi

  # Claude Code ignores this folder's settings.json — permissions AND hooks —
  # until the folder has been trusted once, interactively. Until then the vault
  # looks configured and behaves as though it isn't, which is the worst way for
  # this to fail. Needs jq to answer definitively; stay quiet rather than guess.
  if command -v jq >/dev/null 2>&1 && [ -f "$HOME/.claude.json" ]; then
    trusted=$(jq -r --arg p "$root" \
              '.projects[$p].hasTrustDialogAccepted // false' \
              "$HOME/.claude.json" 2>/dev/null)
    if [ "$trusted" = "true" ]; then
      ok "this folder is trusted, so its settings actually apply"
    else
      warn "Claude Code hasn't trusted this folder yet — it's ignoring the settings in .claude/" \
           "Run  claude  here once and accept the trust prompt. Until you do, you'll be asked to approve routine things, and scheduled runs will be crippled."
    fi
  fi

  # The one setting worth changing before you need it. Session transcripts are
  # deleted after 30 days by default, and ingest-sessions cannot recover them.
  days=""
  if [ -f "$HOME/.claude/settings.json" ]; then
    days=$(sed -n 's/.*"cleanupPeriodDays"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
           "$HOME/.claude/settings.json" 2>/dev/null | head -1)
  fi
  if [ -z "$days" ]; then
    warn "your past AI sessions are being deleted after 30 days (Claude Code's default)" \
         "Add  \"cleanupPeriodDays\": 3650  to ~/.claude/settings.json. Do it now — ingest-sessions can't recover what's already gone."
  elif [ "$days" -lt 365 ]; then
    warn "your past AI sessions are deleted after $days days" \
         "Raise cleanupPeriodDays in ~/.claude/settings.json — 3650 is ten years"
  else
    ok "session history kept for $days days"
  fi

  echo
fi

# ----------------------------------------------------------------- the verdict

plural() { [ "$1" -eq 1 ] && echo "$1 thing" || echo "$1 things"; }

if [ "$fixes" -gt 0 ]; then
  echo "Fixed $(plural "$fixes") along the way — structure only, nothing that holds meaning."
  echo "Run  brain/bin/sync  to commit it, or  --check  next time to look without touching."
fi

if [ "$blockers" -gt 0 ]; then
  echo "$(plural "$blockers") need fixing before this will work."
  [ "$warnings" -gt 0 ] && echo "$(plural "$warnings") worth doing after that."
  echo
  exit 1
fi

if [ "$warnings" -gt 0 ]; then
  echo "Everything works. $(plural "$warnings") worth doing when you have a minute."
elif [ "$fixes" -eq 0 ]; then
  echo "All good."
else
  echo "Everything else is fine."
fi
echo
exit 0
