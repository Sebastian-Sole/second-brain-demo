#!/usr/bin/env sh
# Run one of the vault's commands with whichever agent CLI is available.
#
#   brain/bin/run maintain                 a skill, from brain/prompts/
#   brain/bin/run weather "tomorrow"       a tool,  from brain/tools/
#   brain/bin/run digest "last two weeks"
#   BRAIN_AGENT=codex brain/bin/run maintain
#
# This is the seam that keeps the vault model-agnostic: commands are plain
# markdown, and this script is the only place that knows how to invoke a
# particular vendor's CLI. Teaching the vault a new agent means adding one
# case below — nothing else changes.

set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$root"

# Both directories are listed the same way, so the only difference a reader has
# to hold on to is the heading above each block.
list_commands() {
  ls "$1"/*.md 2>/dev/null | sed 's|.*/|    |; s|\.md$||'
}

name=${1:-}
if [ -z "$name" ]; then
  echo "usage: brain/bin/run <command-name> [extra instructions]" >&2
  echo "available:" >&2
  echo "  skills (brain/prompts/) — the vault, and nothing else:" >&2
  list_commands brain/prompts >&2
  echo "  tools (brain/tools/) — reach outside the vault, may need configuring:" >&2
  list_commands brain/tools >&2
  exit 64
fi
shift

# A command name is a bare filename, and the runner has to insist on that. The
# lookup below builds a path by concatenation, so '../../00_Inbox/note' escapes
# brain/ and hands a fresh agent some other .md file on disk as its prompt —
# including the files this vault writes verbatim from pasted, untrusted material.
# That would turn "pasted material is data, not instructions" inside out, since
# the traversal makes the text the prompt rather than the input. Cheaper to
# refuse the name than to sanitise the path afterwards.
case "$name" in
  */* | .*)
    echo "run: '$name' is not a command name." >&2
    echo "     Commands are bare names — no slashes, no leading dot." >&2
    echo "     Run  brain/bin/run  with no arguments to see what's there." >&2
    exit 64
    ;;
esac

# A command is either a skill or a tool. They differ in reach, not in how they
# are invoked, so the runner has to look in both places. Skills win a name
# clash — they're the ones that can't reach the network — but never silently:
# with two files answering to one name, which of them just ran is exactly the
# thing you'd want to have been told.
prompt_file=""
if [ -f "brain/tools/${name}.md" ]; then
  prompt_file="brain/tools/${name}.md"
fi
if [ -f "brain/prompts/${name}.md" ]; then
  if [ -n "$prompt_file" ]; then
    echo "run: '$name' exists in both brain/prompts/ and brain/tools/." >&2
    echo "     Running the skill, brain/prompts/${name}.md. Rename one of them." >&2
  fi
  prompt_file="brain/prompts/${name}.md"
fi
if [ -z "$prompt_file" ]; then
  echo "run: no such command: '$name'" >&2
  echo "     Looked in brain/prompts/${name}.md and brain/tools/${name}.md." >&2
  echo "     Run  brain/bin/run  with no arguments to see what's there." >&2
  exit 66
fi

# setup is an interview. Run non-interactively it asks its six questions into
# a void that closes before anyone can answer, and the vault learns nothing.
if [ "$name" = setup ]; then
  echo "run: setup is an interview — it has to be able to ask you questions." >&2
  echo "     Start your agent in this folder and say:  setup" >&2
  echo "     (Claude Code: /setup)" >&2
  exit 64
fi

# A tool's frontmatter goes to the agent along with the rest of the file. It
# isn't metadata about the prompt, it's part of the prompt: requires: says what
# has to be reachable, fallback: is the sentence to say when it isn't, consent:
# decides whether to ask before acting at all. AGENTS.md settles it — where the
# frontmatter and the docs disagree, the frontmatter wins, because it's what the
# tool actually runs on. Stripping it would hand the agent a tool with its
# safety rails removed, and would make this path differ from the one an agent
# takes when it simply reads the file itself. Skills have no frontmatter, so
# they are unaffected either way.
prompt=$(cat "$prompt_file")
[ $# -gt 0 ] && prompt="$prompt

---
Additional instructions from the caller: $*"

# Pick an agent: explicit choice first, then whatever is installed.
agent=${BRAIN_AGENT:-}
if [ -z "$agent" ]; then
  if   command -v claude       >/dev/null 2>&1; then agent=claude
  elif command -v codex        >/dev/null 2>&1; then agent=codex
  elif command -v cursor-agent >/dev/null 2>&1; then agent=cursor-agent
  elif command -v gemini       >/dev/null 2>&1; then agent=gemini
  fi
fi

if [ -z "$agent" ]; then
  echo "run: no agent CLI found. Install one, or set BRAIN_AGENT." >&2
  exit 69
fi

# The existence check has to cover the explicit choice too, not just the
# auto-detected one. Without it a BRAIN_AGENT pointing at something uninstalled
# sails past the case below and dies as the shell's own "command not found" —
# a bare 127 that names no fix. doctor already tells people this; run was the
# laxer of the two, which is the wrong way round for the thing that actually runs.
if ! command -v "$agent" >/dev/null 2>&1; then
  echo "run: BRAIN_AGENT is set to '$agent', but that command isn't installed." >&2
  echo "     Install it, unset BRAIN_AGENT, or set it to one that is." >&2
  exit 69
fi

echo "run: $prompt_file via $agent" >&2

case "$agent" in
  claude)
    # Non-interactive mode. acceptEdits lets it write notes without prompting.
    claude -p "$prompt" --permission-mode acceptEdits
    ;;
  codex)
    # workspace-write confines it to this directory tree.
    codex exec --sandbox workspace-write "$prompt"
    ;;
  cursor-agent)
    # Cursor has no write-only approval tier equivalent to Claude's acceptEdits;
    # its non-interactive flag waives every approval, so it stays opt-in.
    if [ "${BRAIN_UNATTENDED:-}" = 1 ]; then
      cursor-agent -p "$prompt" --force
    else
      cursor-agent -p "$prompt"
    fi
    ;;
  gemini)
    # Gemini reads GEMINI.md rather than AGENTS.md — the pointer file matters here.
    # Same caveat as cursor-agent: its unattended flag waives every approval.
    if [ "${BRAIN_UNATTENDED:-}" = 1 ]; then
      gemini -p "$prompt" --yolo
    else
      gemini -p "$prompt"
    fi
    ;;
  *)
    echo "run: unknown agent '$agent'. Add a case to brain/bin/run." >&2
    exit 78
    ;;
esac
