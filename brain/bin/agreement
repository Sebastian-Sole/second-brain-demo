#!/usr/bin/env sh
# Print the compressed working agreement, so its hard rules can be re-stated on
# every turn instead of decaying halfway down a long session.
#
#   brain/bin/agreement           the lines, ready to inject
#   brain/bin/agreement --check   what doctor asks: does it exist, is it in budget
#
# The full agreement lives in [[How we work together]] and is read at session
# start like any other note. This script injects only the three sections that
# must never drift: "Always / Never" (the human's hard rules), "How to talk to
# me" (style, which decays fastest of all) and "Magic words" (the shared
# vocabulary). Everything else in the note is context; these three are contract. Injecting the whole note here would defeat the point — every
# line printed below is paid for on every single prompt, including the one
# where someone asked what the weather is. Keep the extraction narrow.
#
# On Claude Code this is wired to UserPromptSubmit in .claude/settings.json,
# because an instruction given once,
# forty turns ago, competes with everything said since, and loses. The note is
# the source of truth and this script is a convenience over it; agents without
# hooks read the note the ordinary way, because AGENTS.md tells them to.
#
# The note is the human's. If it changed mid-session, the change takes effect
# on the next prompt — this script reads the file fresh every time.
#
# Portable on purpose: POSIX shell and awk.

set -u

NOTE='cortex/03_Resources/How we work together.md'

# The budget. Three sections of three to five bullets each is the intended
# size; the cap leaves headroom, not an invitation.
CAP=18
BYTES=1600

# Same anchor as style: never exit non-zero, never write to stderr. A hook that
# fails puts a "hook error" notice in front of the human on every keypress. A
# missing agreement is not an error — it is a vault whose owner deleted the
# note, which is their right. Silence is the correct output for all of it.
root=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P) || exit 0
[ -f "$root/AGENTS.md" ] && [ -d "$root/brain/bin" ] || exit 0
cd "$root" || exit 0

mode='inject'
case "${1:-}" in
  --check) mode='check' ;;
  -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  '') ;;
  *) exit 0 ;;
esac

if [ ! -f "$NOTE" ]; then
  [ "$mode" = check ] && echo "absent"
  exit 0
fi

# Keep only the bullets under the two contract sections. A "## " heading opens
# or closes a section; frontmatter and blanks never survive.
extract() {
  awk '
    /^## /            { keep = ($0 ~ /Always/ || $0 ~ /How to talk to me/ || $0 ~ /Magic words/); next }
    !keep             { next }
    /^[[:space:]]*$/  { next }
    /^#/              { next }
    { print }
  ' "$NOTE" 2>/dev/null
}

body=$(extract | head -n "$CAP" | cut -c1-200)
lines=$(printf '%s' "$body" | grep -c . 2>/dev/null || echo 0)
lines=$(printf '%s' "$lines" | tr -d ' ')

if [ "$mode" = check ]; then
  total=$(extract | awk 'END { print NR + 0 }')
  echo "${total:-0} $CAP"
  exit 0
fi

[ "${lines:-0}" -gt 0 ] || exit 0

# Labelled, same as the style hook: unlabelled text arriving before the human's
# prompt reads like something they just said. It isn't — it is a standing
# agreement they wrote once, and it binds without being answered.
echo "<working-agreement source=\"$NOTE\">"
echo "The standing agreement between you and this human. Hard rules, how they want to be written to, and shared vocabulary, restated so they cannot drift:"
printf '%s\n' "$body" | head -c "$BYTES"
echo ""
echo "The full agreement is in the note. Only the human edits it; propose lines, never write them."
echo "</working-agreement>"

exit 0
