#!/usr/bin/env sh
# Print who this vault belongs to, so a session starts knowing them instead of
# being asked to remember to find out.
#
#   brain/bin/context           the payload, ready to inject
#
# Three things, in order: the [[About me]] hub in full, the open rows of the
# assumption register, and a headline of what moved in the last day. The hub
# and the open assumptions go whole -- they are small, and their caps live
# where the notes do (doctor holds the hub to 40 lines; check holds the
# register to its form). Recent activity is the part that gets cut, because it
# is the only part that grows without limit, and one line per note is enough
# to know where yesterday left off.
#
# On Claude Code this is wired to SessionStart in .claude/settings.json, on
# `startup`, `clear` and -- most importantly -- `compact`: a summariser
# flattens a 40-line profile into "the user has a profile", so the moment
# after compaction is when the vault most needs re-stating, not least. It does
# not fire on `resume` or `fork`, where the earlier injection is still in the
# transcript and re-firing is waste.
#
# Everything printed here is quoted from the notes. The notes are the source
# of truth and this script is a convenience over them; agents without hooks
# read the same notes at session start because AGENTS.md tells them to. Never
# teach this script a fact the notes don't hold.
#
# Portable on purpose: POSIX shell and awk.

set -u

# Where the notes live, per the folder map in AGENTS.md: the hub and the
# register are both `cortex/03_Resources/` names. One place to edit if the
# scheme moves.
HUB='cortex/03_Resources/About me.md'
REGISTER='cortex/03_Resources/Assumptions.md'

# The whole payload is paid for once per session start -- including the one
# right after a compaction that was done to save space. Keep it around 120
# lines, and spend what the notes leave over on recent activity.
CAP=120
WIDTH=300

# Same anchor as agreement: never exit non-zero, never write to stderr. A hook
# that fails puts a "hook error" notice in front of the human at every session
# start. A vault with no profile yet is not an error -- it is a first
# conversation that hasn't happened. Emit what exists and be quiet about the rest.
root=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P) || exit 0
[ -f "$root/AGENTS.md" ] && [ -d "$root/brain/bin" ] || exit 0
cd "$root" || exit 0

case "${1:-}" in
  -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  '') ;;
  *) exit 0 ;;
esac

# ---------------------------------------------------------------- the sections
#
# Each is computed before anything prints, so the recent-activity budget can be
# whatever the notes didn't spend.

# The hub, frontmatter stripped -- title and dates are for the filesystem, not
# for the reader. Read fresh every time, so an edit lands next session.
about=''
if [ -f "$HUB" ]; then
  about=$(awk 'BEGIN { n = 0 }
               NR == 1 && $0 != "---" { n = 2 }
               /^---$/ && n < 2 { n++; next }
               n >= 2 { print }' "$HUB" 2>/dev/null | cut -c1-"$WIDTH")
fi

# Only the open rows of the register. Confirmed ones are facts and live in the
# notes; refuted ones are calibration, not context. A register with nothing
# open contributes nothing, which is correct.
assumptions=''
if [ -f "$REGISTER" ]; then
  assumptions=$(awk '
    /^> \[!/        { if (inb && open) printf "%s", block
                      block = $0 "\n"; inb = 1; open = 0; next }
    inb && /^>/     { block = block $0 "\n"
                      if ($0 ~ /Status:[[:space:]]*open/) open = 1; next }
    inb             { if (open) printf "%s", block; inb = 0; block = "" }
    END             { if (inb && open) printf "%s", block }
  ' "$REGISTER" 2>/dev/null | cut -c1-"$WIDTH")
fi

# What moved in the last day, one headline line per note. recent already
# refuses to guess when the window is empty; pass its header through and let
# it say so.
recent=''
if [ -x brain/bin/recent ]; then
  recent=$(brain/bin/recent --since 1 2>/dev/null | cut -c1-"$WIDTH") || recent=''
fi

# ------------------------------------------------------------------ the budget
count() { if [ -n "$1" ]; then printf '%s\n' "$1" | wc -l | tr -d ' '; else echo 0; fi }

rows=$(printf '%s\n' "$recent" | grep -cv '^#' 2>/dev/null | tr -d ' ')
heads=$(printf '%s\n' "$recent" | grep -c '^#' 2>/dev/null | tr -d ' ')

# 11 is the framing printed below -- the tag pair, the intro, the section
# markers and their blanks -- counted by hand and cheap to recount.
spent=$(( $(count "$about") + $(count "$assumptions") + ${heads:-0} + 11 ))
room=$(( CAP - spent ))
[ "$room" -ge 5 ] || room=5   # never cut recent to nothing just to honour the cap exactly

# ------------------------------------------------------------------ the output
#
# Labelled, same as the agreement hook: unlabelled text arriving before the
# conversation reads like something the human just said. It isn't -- it is
# their own notes, re-stated.
echo "<vault-context source=\"brain/bin/context\">"
echo "Who this vault belongs to, what is currently assumed about them, and what moved lately — quoted from their notes at session start. The notes are the source of truth; read them for anything deeper."

if [ -n "$about" ]; then
  echo ""
  echo "---- $HUB ----"
  printf '%s\n' "$about"
else
  echo ""
  echo "---- $HUB is missing or empty — say so, and offer /start before anything else. ----"
fi

if [ -n "$assumptions" ]; then
  echo ""
  echo "---- open assumptions, from $REGISTER ----"
  echo "Labelled guesses, not facts. They inform the human's decisions, never authorise yours."
  printf '%s\n' "$assumptions"
fi

if [ -n "$recent" ]; then
  echo ""
  echo "---- recent activity (brain/bin/recent --since 1) ----"
  printf '%s\n' "$recent" | grep '^#'
  if [ "${rows:-0}" -gt "$room" ]; then
    printf '%s\n' "$recent" | grep -v '^#' | head -n "$room"
    echo "$(( rows - room )) more — run brain/bin/recent for the rest"
  else
    printf '%s\n' "$recent" | grep -v '^#'
  fi
fi

echo "</vault-context>"

exit 0
