#!/usr/bin/env sh
# Find and stage AI session transcripts so an agent can read them.
#
#   brain/bin/sessions list [pattern]        what's on this machine
#   brain/bin/sessions stage <pattern> [n]   copy the n newest matches in (default 5)
#   brain/bin/sessions turns [pattern] [since]  the human's own turns, nothing else
#   brain/bin/sessions clean                 delete everything staged
#
# Why this exists: agent CLIs sandbox themselves to the working directory, so
# none of them can read ~/.claude/projects or ~/.codex/sessions no matter how
# you invoke them. Rather than teaching every agent a different escape hatch,
# this script — plain POSIX shell, no jq, no runtime — copies the transcripts
# you asked for into cortex/raw/sessions/transcripts/, which is gitignored. The agent
# then reads them with the same tools it uses for everything else.
#
# Nothing staged here is ever committed. Run `clean` when you're done.

set -eu

# Anchor to the script's own location, not the working directory: asking git
# for the toplevel walks upward, so a vault nested in another repo makes this
# write elsewhere — and this script, unlike the others, writes transcripts.
root=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P) || root=''

# The same guard doctor uses for in_vault: structure is what proves we are in
# the vault, rather than in some directory that merely contains one.
if [ -z "$root" ] || [ ! -f "$root/AGENTS.md" ] || [ ! -d "$root/brain/bin" ]; then
  echo "sessions: ${root:-$0} is not a vault — AGENTS.md and brain/bin/ should both be there. Nothing was copied." >&2
  exit 1
fi
cd "$root" || exit 1

stage_dir="cortex/raw/sessions/transcripts"
claude_dir="$HOME/.claude/projects"
codex_dir="$HOME/.codex/sessions"

# mtime as YYYY-MM-DD. `date -r <file>` works on both BSD and GNU date.
mtime() { date -r "$1" +%Y-%m-%d 2>/dev/null || echo "????-??-??"; }

# Claude Code encodes the project path in the directory name: /Users/me/foo
# becomes -Users-me-foo. The encoding is lossy — a hyphen in a real folder name
# is indistinguishable from a separator — so "My-Notes" comes back as "My/Notes".
# Good enough to match and display; don't treat the result as a real path.
decode() { echo "$1" | sed 's|-|/|g'; }

# Codex stores the project path as "cwd":"..." in the first line of the file.
codex_cwd() { sed -n '1s/.*"cwd":"\([^"]*\)".*/\1/p' "$1" 2>/dev/null; }

cmd=${1:-list}
[ $# -gt 0 ] && shift

case "$cmd" in
  list)
    pattern=${1:-}
    if [ -d "$claude_dir" ]; then
      echo "Claude Code — $claude_dir"
      for d in "$claude_dir"/*/; do
        [ -d "$d" ] || continue
        name=$(basename "$d")
        proj=$(decode "$name")
        case "$proj" in *"${pattern}"*) ;; *) [ -n "$pattern" ] && continue ;; esac
        n=$(find "$d" -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' ')
        [ "$n" -eq 0 ] && continue
        newest=$(ls -t "$d"*.jsonl 2>/dev/null | head -1)
        printf '  %-4s sessions  %s  %s\n' "$n" "$(mtime "${newest:-$d}")" "$proj"
      done
    fi
    if [ -d "$codex_dir" ]; then
      echo "Codex — $codex_dir"
      find "$codex_dir" -name 'rollout-*.jsonl' 2>/dev/null | while read -r f; do
        proj=$(codex_cwd "$f")
        [ -n "$proj" ] || continue
        case "$proj" in *"${pattern}"*) ;; *) [ -n "$pattern" ] && continue ;; esac
        echo "$proj"
      done | sort | uniq -c | sort -rn | while read -r n proj; do
        printf '  %-4s sessions  %s\n' "$n" "$proj"
      done
    fi
    [ -d "$claude_dir" ] || [ -d "$codex_dir" ] || {
      echo "No agent session directories found on this machine." >&2
      exit 69
    }
    ;;

  stage)
    pattern=${1:-}
    [ -n "$pattern" ] || { echo "usage: sessions stage <pattern> [n]" >&2; exit 64; }
    limit=${2:-5}

    # The path fix above is one way the destination goes wrong; this checks
    # the property that matters — will git commit what lands there? A probe
    # file *inside* stage_dir is asked about, since the gitignore rule ends in
    # a slash and the directory may not exist yet. 0 = ignored, continue.
    # 1 = not ignored, refuse. 128 = no git repo, nothing to leak into.
    # `rc=$?` guards this: exit 1 is the *normal* answer, and a bare call
    # would end the script silently under `set -e`.
    rc=0
    git check-ignore -q "$stage_dir/probe.jsonl" 2>/dev/null || rc=$?
    if [ "$rc" -eq 1 ]; then
      echo "sessions: git is NOT ignoring $stage_dir, so anything copied there would be committed and pushed on the next turn." >&2
      echo "          Transcripts hold credentials, client code and anything you ever pasted into a session." >&2
      echo "          Nothing was copied. Check that .gitignore still has the line: cortex/raw/sessions/transcripts/" >&2
      exit 1
    fi

    mkdir -p "$stage_dir"

    # Collect every match first, then sort by recency across ALL of them, so
    # "the 3 newest" means the 3 newest overall — not 3 from each directory.
    # A project with a git worktree has more than one directory here.
    #
    # One path per line, and it stays that way to the end. The old list was
    # space-separated on the theory that these paths have no spaces — true of
    # Claude Code's encoded directory names, false of the $HOME prepended to
    # them. A "John Smith" home turned every match into two paths that don't
    # exist, and the stage copied nothing while reporting success.
    matches=""
    if [ -d "$claude_dir" ]; then
      for d in "$claude_dir"/*/; do
        [ -d "$d" ] || continue
        proj=$(decode "$(basename "$d")")
        case "$proj" in *"${pattern}"*) ;; *) continue ;; esac
        found=$(find "$d" -maxdepth 1 -name '*.jsonl' 2>/dev/null)
        [ -n "$found" ] && matches="$matches$found
"
      done
    fi
    if [ -d "$codex_dir" ]; then
      # Same defect, same fix. Word-splitting find's output handed codex_cwd a
      # truncated half-path; its sed then failed on a file that isn't there and,
      # under set -e, took the whole script down with it — no message, exit 1.
      # Splitting on newline instead keeps each path whole. A `while read`
      # pipeline would too, but it runs in a subshell that can't reach $matches.
      found=$(find "$codex_dir" -name 'rollout-*.jsonl' 2>/dev/null)
      ifs=$IFS
      IFS='
'
      # shellcheck disable=SC2086  # splitting on newlines only — that is the point
      set -- $found
      IFS=$ifs
      for f in "$@"; do
        proj=$(codex_cwd "$f")
        case "$proj" in *"${pattern}"*) ;; *) continue ;; esac
        matches="$matches$f
"
      done
    fi

    [ -n "$matches" ] || {
      echo "sessions: nothing matches '$pattern' — try: brain/bin/sessions list" >&2
      exit 66
    }

    # ls -t does the newest-first sort, but only when it's handed the paths as
    # separate arguments — so split on newline alone, the one character these
    # filenames can't contain, and let ls re-emit them in order.
    ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086  # splitting on newlines only — that is the point
    set -- $matches
    matches=$(ls -t "$@" 2>/dev/null)
    # shellcheck disable=SC2086
    set -- $matches
    IFS=$ifs

    staged=0
    for f in "$@"; do
      [ "$staged" -lt "$limit" ] || break
      case "$f" in
        "$codex_dir"/*) cp "$f" "$stage_dir/codex--$(basename "$f")" ;;
        *)              cp "$f" "$stage_dir/claude--$(basename "$f")" ;;
      esac
      staged=$((staged + 1))
    done

    # Matching files but staging none is a failure, not a quiet success:
    # ingest-sessions reads this exit status, and a cheerful 0 tells it there
    # was nothing to ingest — which is how the bug above stayed invisible.
    [ "$staged" -gt 0 ] || {
      echo "sessions: matched files for '$pattern' but staged none — are they readable?" >&2
      exit 69
    }

    echo "staged $staged transcript(s) matching '$pattern' into $stage_dir" >&2
    echo "remember to run: brain/bin/sessions clean" >&2
    ls -la "$stage_dir" | tail -n +4
    ;;

  turns)
    # Emit only the human's own typed turns, from the source directories, and
    # write nothing anywhere. This is the input to the "how you work with AI"
    # pass in ingest-sessions.
    #
    # Two reasons it reads the source dirs instead of the staged copies:
    # breadth beats depth for pattern-finding (you want two hundred sessions,
    # not five), and staging two hundred transcripts means copying gigabytes
    # into the working tree to throw them away again. This script is not
    # sandboxed the way the agent is, so it crosses that boundary once and
    # hands back only the filtered text.
    #
    # And the filter is the whole point. Roughly half of every record carrying
    # role "user" was never typed by a human: task notifications, messages from
    # other agent sessions, image metadata, skill payloads, hook output. Fed
    # that raw, an agent concludes its owner communicates in XML status
    # updates -- a profile of the harness wearing the human's name. AGENTS.md
    # gate 2 already names the failure; this is where it gets prevented.
    pattern=${1:-}
    since=${2:-}

    find_args="$claude_dir"
    [ -d "$codex_dir" ] && find_args="$find_args $codex_dir"
    # shellcheck disable=SC2086
    files=$(find $find_args -name '*.jsonl' -type f 2>/dev/null \
            | grep -v '/subagents/' \
            | { [ -n "$pattern" ] && grep -i -- "$pattern" || cat; })

    [ -n "$files" ] || {
      echo "sessions: no transcripts${pattern:+ matching '$pattern'}. Nothing to read." >&2
      exit 66
    }

    # Newest first, and only what the human asked for. Splitting on newline is
    # safe here for the same reason it is in `stage`.
    ifs=$IFS; IFS='
'
    # shellcheck disable=SC2086
    set -- $files
    IFS=$ifs
    total=$#

    printf '%s\n' "$@" | while read -r f; do
      [ -n "$since" ] && [ "$(mtime "$f")" \< "$since" ] && continue
      case "$f" in
        "$codex_dir"/*) tag="codex:$(basename "$f" .jsonl | cut -c1-8)" ;;
        *) tag="$(basename "$(dirname "$f")" | cut -c1-28):$(basename "$f" .jsonl | cut -c1-8)" ;;
      esac
      TAG="$tag" DATE="$(mtime "$f")" awk '
        # --- JSON string reader. Walks escapes rather than trusting a greedy
        # --- regex, because a quote inside a turn is not a terminator.
        function jstr(s, i,   out, c, n) {
          out = ""
          n = length(s)
          while (i <= n) {
            c = substr(s, i, 1)
            if (c == "\\") { out = out substr(s, i, 2); i += 2; continue }
            if (c == "\"") return out
            out = out c; i++
          }
          return out
        }
        function unesc(t) {
          gsub(/\\n/, "\n", t); gsub(/\\t/, "  ", t)
          gsub(/\\"/, "\"", t); gsub(/\\r/, "", t)
          gsub(/\\u[0-9a-fA-F]{4}/, "?", t)
          gsub(/\\\\/, "\\", t)
          return t
        }
        # Everything below arrives wearing the human role and was not typed by
        # one. Order matters only for readability; each is a whole-prefix test.
        function machine(t) {
          return t ~ /^[[:space:]]*<(system-reminder|command-name|command-message|command-args|local-command-(stdout|stderr|caveat)|user-prompt-submit-hook|working-agreement|task-notification|teammate-message|persisted-output|bash-(input|stdout|stderr)|system_instruction|available-skills|budget-|fleet-)/ ||
                 t ~ /^[[:space:]]*(Caveat: The messages below|\[Request interrupted|Another Claude session sent a message|Base directory for this skill:|The following deferred tools|Tool loaded\.|Stop hook feedback:|\(Re-invocation of \/)/ ||
                 t ~ /^[[:space:]]*Read `brain\/(prompts|tools)\// ||
                 t ~ /^[[:space:]]*@brain\/(prompts|tools)\//
        }
        $0 !~ /"type"[[:space:]]*:[[:space:]]*"user"/ && $0 !~ /"role"[[:space:]]*:[[:space:]]*"user"/ { next }
        {
          line = $0
          # Content is either a bare string or an array of blocks. Tool results
          # also arrive as role "user"; they carry no "text" key, so pulling
          # every "text" value drops them without a special case.
          n = 0
          rest = line
          while (match(rest, /"text"[[:space:]]*:[[:space:]]*"/)) {
            piece = jstr(rest, RSTART + RLENGTH - 1 + 1)
            parts[++n] = piece
            rest = substr(rest, RSTART + RLENGTH)
          }
          if (n == 0 && match(line, /"content"[[:space:]]*:[[:space:]]*"/)) {
            parts[++n] = jstr(line, RSTART + RLENGTH - 1 + 1)
          }
          for (k = 1; k <= n; k++) {
            t = unesc(parts[k])
            # An image paste followed by a typed question is a real turn; the
            # bare metadata line is not.
            while (t ~ /^[[:space:]]*\[Image[^]]*\]/) sub(/^[[:space:]]*\[Image[^]]*\][[:space:]]*/, "", t)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
            if (t == "") { continue }
            if (machine(t)) { dropped++; continue }
            kept++
            printf "\n── %s · %s · #%d\n%s\n", ENVIRON["TAG"], ENVIRON["DATE"], kept, t
          }
          delete parts
        }
        END { printf "%s\t%d\t%d\n", ENVIRON["TAG"], kept + 0, dropped + 0 > "/dev/stderr" }
      ' "$f"
    done 2>/tmp/sessions-turns-$$.tsv

    k=$(awk -F'\t' '{k+=$2; d+=$3} END{print k+0}' /tmp/sessions-turns-$$.tsv 2>/dev/null)
    d=$(awk -F'\t' '{k+=$2; d+=$3} END{print d+0}' /tmp/sessions-turns-$$.tsv 2>/dev/null)
    s=$(awk -F'\t' '$2>0' /tmp/sessions-turns-$$.tsv 2>/dev/null | wc -l | tr -d ' ')
    rm -f /tmp/sessions-turns-$$.tsv
    # Say what was filtered. A pass that silently drops half its input reads as
    # full coverage, and the drop rate is itself a finding worth seeing.
    echo "sessions turns: $total transcript(s) scanned, $s with human turns; kept $k, dropped $d machine-authored." >&2
    ;;

  clean)
    rm -rf "$stage_dir"
    echo "cleaned $stage_dir" >&2
    ;;

  *)
    echo "usage: sessions {list|stage|turns|clean}" >&2
    exit 64
    ;;
esac
