{
  "permissions": {
    "allow": [
      "Bash(brain/bin/doctor)",
      "Bash(brain/bin/check)",
      "Bash(brain/bin/sync)",
      "Bash(brain/bin/sync:*)",
      "Bash(brain/bin/run:*)",
      "Bash(brain/bin/sessions:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/brain/bin/sync\"",
            "statusMessage": "Saving your second brain…",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
