# OS cruft
.DS_Store
Thumbs.db

# Obsidian per-machine UI state (safe to ignore; the notes are the vault)
cortex/.obsidian/workspace*.json
cortex/.obsidian/cache
.trash/

# Local settings that shouldn't be shared
.claude/settings.local.json

# Credentials. `sync` runs `git add -A` unattended after every agent turn, so
# anything that lands in this folder is committed — and pushed — before the
# human has finished reading the reply that put it there. A key pasted into
# 00_Inbox/ is a key on GitHub. These patterns are the cheap half of the fix;
# the other half is not pasting secrets into your notes.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
.netrc
credentials.json
service-account*.json

# Ingested AI session transcripts. `ingest-sessions` writes short session notes
# into the vault and leaves the transcripts themselves outside git — they are
# enormous (gigabytes) and full of credentials, client code and pasted secrets.
# If you ever copy one in for reference, it lands here and stays uncommitted.
cortex/raw/sessions/transcripts/

# Local agent worktrees, never commit
.claude/worktrees/

# The ingest allowlist names the human's clients and employers. ingest-sessions
# writes it, and sync commits and pushes on the very next turn -- before anyone
# has seen the file. It exists so later runs don't re-ask; that job is local.
cortex/06_Sessions/scope.md

# The calendar feed URL is a bearer secret: anyone holding it can read the whole
# calendar. `start` writes it here when the human picks the read-only route, and
# sync must never push it.
cortex/raw/calendar-feed.url
